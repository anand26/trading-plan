# Database
SQL_SERVER=localhost
SQL_DATABASE=TradingDB
SQL_TRUSTED_CONNECTION=yes

# LEAN Engine Paths
LEAN_PATH=../quantconnect-lean
LEAN_DATA_PATH=../quantconnect-lean/Data
LEAN_RESULTS_PATH=./results

# Alpaca Paper Trading
ALPACA_PAPER_KEY=your_paper_key_here
ALPACA_PAPER_SECRET=your_paper_secret_here
ALPACA_PAPER_URL=https://paper-api.alpaca.markets

# Alpaca Live Trading (Keep these secure!)
ALPACA_LIVE_KEY=your_live_key_here
ALPACA_LIVE_SECRET=your_live_secret_here
ALPACA_LIVE_URL=https://api.alpaca.markets

# Safety Settings
LIVE_DEPLOY_ENABLED=false
LIVE_CONFIRM_CODE=DEPLOY_LIVE_2026
MAX_POSITION_SIZE=10000
DAILY_LOSS_LIMIT=500
