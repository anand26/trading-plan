# ============================================
# MASTER CONFIGURATION FILE
# Copy this to .env and fill in your values
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_SERVER=WINDOWS-8ROVTQL
DB_NAME=TradingDB
DB_DRIVER=ODBC Driver 17 for SQL Server
# For SQL Server Authentication (leave blank for Windows Auth):
DB_USERNAME=sa
DB_PASSWORD=sa123

# ============================================
# ALPACA API CONFIGURATION
# ============================================
# Paper Trading (default)
ALPACA_API_KEY=PK264SQEMSSKRRLJUJDB5Q3BHB
ALPACA_SECRET_KEY=9J9ZvYQrQg1VD9FjU3yaZHiMgmN1LWZwKucTgJ6nRg6Y
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live Trading (uncomment and fill when ready for live)
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_SECRET_KEY=
# ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ============================================
# TRADING MODE
# ============================================
# Options: paper, live, backtest
TRADING_MODE=paper

# ============================================
# AGENT CONFIGURATION
# ============================================
AGENT_MODE=paper
DRY_RUN=true
CYCLE_INTERVAL_SECONDS=60
LEARNING_ENABLED=true
AUTO_APPLY_RECOMMENDATIONS=false

# ============================================
# RISK THRESHOLDS
# ============================================
MIN_CONFIDENCE_TO_ACT=0.7
MAX_DAILY_PARAMETER_CHANGES=5
EMERGENCY_DRAWDOWN_PCT=0.15
MAX_POSITION_SIZE_PCT=0.20
MAX_DAILY_LOSS_PCT=0.05
MAX_CONSECUTIVE_LOSSES=5
COOLDOWN_AFTER_LOSSES_MINUTES=30

# ============================================
# STRATEGY PARAMETERS (Defaults)
# ============================================
RSI_ENTRY_THRESHOLD=35
RSI_EXIT_THRESHOLD=65
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.03
SCALP_SIZE=100
USE_TRAILING_STOP=true
TRAILING_STOP_PCT=0.015

# ============================================
# NOTIFICATIONS (Optional)
# ============================================
NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
EMAIL_SMTP_SERVER=
EMAIL_FROM=
EMAIL_TO=

# ============================================
# QUANTCONNECT / LEAN (If using cloud)
# ============================================
QC_USER_ID=
QC_API_TOKEN=
QC_ORGANIZATION_ID=

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
DEBUG=false

# ============================================
# PATHS (Usually auto-detected)
# ============================================
# LEAN_CLI_PATH=
# DATA_FOLDER=./data
# LOGS_FOLDER=./logs
