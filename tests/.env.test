# Test environment configuration
# Copy to .env.test and adjust values

# Database - use test database to avoid affecting production
DB_SERVER=localhost
DB_NAME=TradingDB
DB_DRIVER=ODBC Driver 17 for SQL Server

# Agent settings for testing
AGENT_MODE=paper
DRY_RUN=true
CYCLE_INTERVAL_SECONDS=5
MIN_CONFIDENCE_TO_ACT=0.7

# Learning settings
LEARNING_ENABLED=true
AUTO_APPLY_RECOMMENDATIONS=false

# Test mode flag
TEST_MODE=true
