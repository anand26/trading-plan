# Agent Configuration
AGENT_MODE=paper  # paper | live
CYCLE_INTERVAL_SECONDS=60
LEARNING_ENABLED=true
AUTO_APPLY_RECOMMENDATIONS=false
DRY_RUN=false

# Decision Thresholds
MIN_CONFIDENCE_TO_ACT=0.7
MAX_DAILY_PARAMETER_CHANGES=5
EMERGENCY_DRAWDOWN_PCT=0.15

# Risk Limits
MAX_POSITION_SIZE_PCT=0.20
MAX_DAILY_LOSS_PCT=0.05

# Database Configuration
DB_SERVER=localhost
DB_NAME=TradingDB
DB_DRIVER=ODBC Driver 17 for SQL Server

# MCP Server Endpoints (if using HTTP)
# LEAN_OPS_URL=http://localhost:8001
# TRADE_MIND_URL=http://localhost:8002

# Alpaca API (for live/paper trading)
ALPACA_API_KEY=your_api_key
ALPACA_SECRET_KEY=your_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Notifications
NOTIFICATIONS_ENABLED=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...
# EMAIL_SMTP_SERVER=smtp.gmail.com

# Debug Mode
DEBUG=false
LOG_LEVEL=INFO
