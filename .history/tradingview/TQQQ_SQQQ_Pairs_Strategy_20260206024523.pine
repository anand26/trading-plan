// ============================================================================
// TQQQ/SQQQ Pairs Ratio Strategy - Z-Score Mean Reversion
// Version: 3.2.1 (Enhanced Visuals + Trend Filter Info)
// 
// Signal Logic:
//   - Z-score < -entry → TQQQ is cheap → BUY TQQQ (uptrend/neutral only)
//   - Z-score > +entry → SQQQ is cheap → BUY SQQQ (downtrend/neutral only)
//   - Exit when Z-score normalizes toward 0
// ============================================================================

//@version=5
indicator("TQQQ/SQQQ Pairs Z-Score v3.2", overlay=false, precision=3)

// ============================================================================
// INPUTS
// ============================================================================

// Z-Score Parameters
grp_zscore = "═══ Z-Score Settings ═══"
zscore_lookback = input.int(46, "Lookback Bars", minval=10, maxval=200, group=grp_zscore, tooltip="Rolling window for Z-score. Optimal: 46")
entry_zscore = input.float(1.5, "Entry Threshold (±)", minval=0.5, maxval=3.0, step=0.1, group=grp_zscore, tooltip="Enter when |Z| > this")
exit_zscore = input.float(0.32, "Exit Threshold (±)", minval=0.1, maxval=1.0, step=0.01, group=grp_zscore, tooltip="Exit when |Z| < this")
stop_zscore = input.float(3.0, "Stop Threshold (±)", minval=2.0, maxval=5.0, step=0.25, group=grp_zscore, tooltip="Stop if |Z| exceeds this")

// Trend Filter (visual only — actual filtering in algo/webhook)
grp_trend = "═══ Trend Filter (QQQ SMA) ═══"
show_trend = input.bool(true, "Show Trend Regime", group=grp_trend)
sma_fast_len = input.int(50, "Fast SMA Period", minval=10, maxval=100, group=grp_trend)
sma_slow_len = input.int(200, "Slow SMA Period", minval=100, maxval=500, group=grp_trend)

// Execution
grp_exec = "═══ Execution ═══"
position_size = input.float(0.57, "Position Size (%)", minval=0.1, maxval=1.0, step=0.01, group=grp_exec)
stop_loss_pct = input.float(0.02, "Stop Loss (%)", minval=0.005, maxval=0.10, step=0.005, group=grp_exec)

// Visuals
grp_viz = "═══ Display ═══"
show_fills = input.bool(true, "Show Zone Fills", group=grp_viz)
show_table = input.bool(true, "Show Info Table", group=grp_viz)
show_labels = input.bool(true, "Show Signal Labels", group=grp_viz)

// ============================================================================
// DATA
// ============================================================================

tqqq_price = request.security("TQQQ", timeframe.period, close)
sqqq_price = request.security("SQQQ", timeframe.period, close)
qqq_price  = request.security("QQQ",  timeframe.period, close)
qqq_close_d = request.security("QQQ", "D", close)

// ============================================================================
// CALCULATIONS
// ============================================================================

// Price ratio & Z-score
price_ratio = tqqq_price / sqqq_price
ratio_mean  = ta.sma(price_ratio, zscore_lookback)
ratio_std   = ta.stdev(price_ratio, zscore_lookback)
zscore      = ratio_std != 0 ? (price_ratio - ratio_mean) / ratio_std : 0.0

// QQQ trend (for display — actual gating is in the algo)
qqq_sma_fast = ta.sma(qqq_close_d, sma_fast_len)
qqq_sma_slow = ta.sma(qqq_close_d, sma_slow_len)
trend_up   = qqq_close_d > qqq_sma_fast and qqq_close_d > qqq_sma_slow
trend_down = qqq_close_d < qqq_sma_fast and qqq_close_d < qqq_sma_slow
trend_str  = trend_up ? "UPTREND ▲" : trend_down ? "DOWNTREND ▼" : "NEUTRAL ◆"
trend_col  = trend_up ? color.green : trend_down ? color.red : color.yellow

// Z-score distance to thresholds
dist_to_tqqq_entry = -entry_zscore - zscore
dist_to_sqqq_entry = zscore - entry_zscore
proximity_pct = math.max(math.abs(zscore) / entry_zscore * 100, 0)

// ============================================================================
// POSITION TRACKING
// ============================================================================

var string position_state = "FLAT"
var float  entry_price     = na
var float  entry_z         = na
var int    entry_bar       = na
var int    trade_count     = 0
var int    win_count       = 0
var float  session_pnl     = 0.0

// Entry signals
buy_tqqq = zscore < -entry_zscore and position_state == "FLAT"
buy_sqqq = zscore >  entry_zscore and position_state == "FLAT"

// Exit signals
exit_tqqq_ok   = position_state == "LONG_TQQQ" and zscore > -exit_zscore
exit_tqqq_stop = position_state == "LONG_TQQQ" and zscore < -stop_zscore
exit_sqqq_ok   = position_state == "LONG_SQQQ" and zscore <  exit_zscore
exit_sqqq_stop = position_state == "LONG_SQQQ" and zscore >  stop_zscore
exit_signal    = exit_tqqq_ok or exit_tqqq_stop or exit_sqqq_ok or exit_sqqq_stop

// Current unrealized P&L
cur_price = position_state == "LONG_TQQQ" ? tqqq_price : position_state == "LONG_SQQQ" ? sqqq_price : na
unreal_pnl_pct = not na(entry_price) and entry_price > 0 ? (cur_price - entry_price) / entry_price * 100 : 0.0
hold_bars = not na(entry_bar) ? bar_index - entry_bar : 0

// State machine
if buy_tqqq
    position_state := "LONG_TQQQ"
    entry_price    := tqqq_price
    entry_z        := zscore
    entry_bar      := bar_index
else if buy_sqqq
    position_state := "LONG_SQQQ"
    entry_price    := sqqq_price
    entry_z        := zscore
    entry_bar      := bar_index
else if exit_signal
    trade_count += 1
    if not na(entry_price)
        exit_p = position_state == "LONG_TQQQ" ? tqqq_price : sqqq_price
        pnl_val = (exit_p - entry_price) / entry_price * 100
        session_pnl += pnl_val
        if pnl_val > 0
            win_count += 1
    position_state := "FLAT"
    entry_price    := na
    entry_z        := na
    entry_bar      := na

// ============================================================================
// PLOTTING — Z-SCORE LINE (color-coded by zone)
// ============================================================================

z_color = zscore < -entry_zscore ? color.lime :
          zscore >  entry_zscore ? #ff5252 :
          zscore < -exit_zscore  ? color.new(color.green, 40) :
          zscore >  exit_zscore  ? color.new(color.red, 40) :
          color.new(#2196F3, 0)

plot(zscore, "Z-Score", color=z_color, linewidth=3)

// ============================================================================
// THRESHOLD ZONES (filled bands)
// ============================================================================

p_entry_hi  = plot(entry_zscore,  "Entry SQQQ",  color=color.new(color.red, 70),    linewidth=1, style=plot.style_line)
p_entry_lo  = plot(-entry_zscore, "Entry TQQQ",  color=color.new(color.green, 70),  linewidth=1, style=plot.style_line)
p_exit_hi   = plot(exit_zscore,   "Exit SQQQ",   color=color.new(color.orange, 80), linewidth=1, style=plot.style_line)
p_exit_lo   = plot(-exit_zscore,  "Exit TQQQ",   color=color.new(color.orange, 80), linewidth=1, style=plot.style_line)
p_stop_hi   = plot(stop_zscore,   "Stop SQQQ",   color=color.new(color.red, 50),    linewidth=2, style=plot.style_line)
p_stop_lo   = plot(-stop_zscore,  "Stop TQQQ",   color=color.new(color.red, 50),    linewidth=2, style=plot.style_line)
p_zero      = plot(0,             "Zero",         color=color.new(color.gray, 60),   linewidth=1, style=plot.style_line)

// Zone fills
fill(p_exit_hi,  p_exit_lo,  color=show_fills ? color.new(color.gray, 92) : na,   title="Neutral Zone")
fill(p_entry_hi, p_stop_hi,  color=show_fills ? color.new(color.red, 92) : na,    title="SQQQ Entry Zone")
fill(p_entry_lo, p_stop_lo,  color=show_fills ? color.new(color.green, 92) : na,  title="TQQQ Entry Zone")

// Background — position active
bgcolor(position_state == "LONG_TQQQ" ? color.new(color.green, 92) : position_state == "LONG_SQQQ" ? color.new(color.red, 92) : na, title="Position BG")

// ============================================================================
// SIGNAL MARKERS + LABELS
// ============================================================================

plotshape(buy_tqqq, "▲ Buy TQQQ", shape.labelup,   location.bottom, color.green, text="TQQQ", textcolor=color.white, size=size.small)
plotshape(buy_sqqq, "▼ Buy SQQQ", shape.labeldown,  location.top,    color.red,   text="SQQQ", textcolor=color.white, size=size.small)
plotshape(exit_tqqq_ok or exit_sqqq_ok,     "✓ Exit OK",   shape.diamond, location.absolute, color.new(color.lime, 20),    size=size.tiny)
plotshape(exit_tqqq_stop or exit_sqqq_stop, "✗ Exit Stop", shape.diamond, location.absolute, color.new(color.fuchsia, 20), size=size.tiny)

if show_labels and buy_tqqq
    label.new(bar_index, zscore, "BUY TQQQ\n$" + str.tostring(tqqq_price, "#.##") + "\nZ=" + str.tostring(zscore, "#.##"), 
              color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)
if show_labels and buy_sqqq
    label.new(bar_index, zscore, "BUY SQQQ\n$" + str.tostring(sqqq_price, "#.##") + "\nZ=" + str.tostring(zscore, "#.##"), 
              color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
if show_labels and exit_signal
    ex_reason = exit_tqqq_ok ? "✓ Normalized" : exit_tqqq_stop ? "✗ Z-Stop" : exit_sqqq_ok ? "✓ Normalized" : "✗ Z-Stop"
    label.new(bar_index, zscore, "EXIT\n" + ex_reason, 
              color=color.new(color.orange, 20), textcolor=color.white, style=label.style_label_center, size=size.tiny)

// ============================================================================
// INFO TABLE (16-row dashboard)
// ============================================================================

if show_table and barstate.islast
    var table t = table.new(position.top_right, 2, 16, 
                            bgcolor=color.new(#1a1a2e, 5), 
                            border_width=1, 
                            border_color=color.new(color.gray, 70),
                            frame_width=2,
                            frame_color=color.new(color.gray, 50))
    
    // Header
    table.cell(t, 0, 0, "PAIRS Z-SCORE", text_color=color.new(#00d2ff, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 0, "v3.2",          text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    
    // ── Z-Score ──
    z_display_col = zscore < -entry_zscore ? color.lime : zscore > entry_zscore ? #ff5252 : #2196F3
    table.cell(t, 0, 1, "Z-Score",    text_color=color.gray,    text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 1, str.tostring(zscore, "#.###"), text_color=z_display_col, text_size=size.normal, text_halign=text.align_right)
    
    prox_str = zscore > 0 ? str.tostring(dist_to_sqqq_entry, "#.##") + " to SQQQ" : str.tostring(dist_to_tqqq_entry, "#.##") + " to TQQQ"
    prox_col = proximity_pct > 80 ? color.yellow : color.gray
    table.cell(t, 0, 2, "→ Entry Dist", text_color=color.new(color.gray, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 2, prox_str,       text_color=prox_col,                   text_size=size.tiny, text_halign=text.align_right)
    
    // ── Prices ──
    table.cell(t, 0, 3, "─── Prices ───", text_color=color.new(color.gray, 40), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 3, "",                text_color=color.gray,                text_size=size.tiny)
    
    table.cell(t, 0, 4, "TQQQ",       text_color=color.new(color.green, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 4, "$" + str.tostring(tqqq_price, "#.##"), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    table.cell(t, 0, 5, "SQQQ",       text_color=color.new(color.red, 20),   text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 5, "$" + str.tostring(sqqq_price, "#.##"), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    table.cell(t, 0, 6, "Ratio",      text_color=color.gray,    text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 6, str.tostring(price_ratio, "#.####"),     text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    // ── Position ──
    table.cell(t, 0, 7, "─── Position ───", text_color=color.new(color.gray, 40), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 7, "",                  text_color=color.gray,                text_size=size.tiny)
    
    pos_col = position_state == "LONG_TQQQ" ? color.lime : position_state == "LONG_SQQQ" ? #ff5252 : color.gray
    pos_icon = position_state == "LONG_TQQQ" ? "▲ LONG TQQQ" : position_state == "LONG_SQQQ" ? "▼ LONG SQQQ" : "— FLAT —"
    table.cell(t, 0, 8, "State",       text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 8, pos_icon,      text_color=pos_col,    text_size=size.small, text_halign=text.align_right)
    
    pnl_str  = position_state != "FLAT" ? str.tostring(unreal_pnl_pct, "#.##") + "%" : "—"
    pnl_col  = position_state == "FLAT" ? color.gray : unreal_pnl_pct > 0 ? color.lime : #ff5252
    table.cell(t, 0, 9, "Unreal P&L",  text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 9, pnl_str,       text_color=pnl_col,    text_size=size.small, text_halign=text.align_right)
    
    hold_str = position_state != "FLAT" ? str.tostring(hold_bars) + " bars" : "—"
    table.cell(t, 0, 10, "Hold Time",   text_color=color.gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 10, hold_str,      text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    // ── Trend ──
    table.cell(t, 0, 11, "─── Trend ───", text_color=color.new(color.gray, 40), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 11, "",               text_color=color.gray,                text_size=size.tiny)
    
    table.cell(t, 0, 12, "QQQ Regime",  text_color=color.gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 12, show_trend ? trend_str : "OFF", text_color=show_trend ? trend_col : color.gray, text_size=size.small, text_halign=text.align_right)
    
    qqq_str = "$" + str.tostring(qqq_close_d, "#.##")
    table.cell(t, 0, 13, "QQQ",         text_color=color.gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 13, qqq_str,       text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    // ── Session Stats ──
    table.cell(t, 0, 14, "─── Stats ───", text_color=color.new(color.gray, 40), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 14, "",               text_color=color.gray,                text_size=size.tiny)
    
    wr_str = trade_count > 0 ? str.tostring(win_count / trade_count * 100, "#.0") + "% (" + str.tostring(trade_count) + ")" : "—"
    table.cell(t, 0, 15, "Win Rate",     text_color=color.gray,  text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 15, wr_str,         text_color=color.white, text_size=size.small, text_halign=text.align_right)

// ============================================================================
// ALERTS WITH JSON PAYLOAD
// ============================================================================

if buy_tqqq
    msg = '{"action":"BUY_TQQQ","symbol":"TQQQ","position_size":' + str.tostring(position_size) + ',"stop_loss_pct":' + str.tostring(stop_loss_pct) + ',"zscore":' + str.tostring(zscore, "#.##") + ',"price":' + str.tostring(tqqq_price, "#.##") + ',"ratio":' + str.tostring(price_ratio, "#.####") + ',"trend":"' + trend_str + '"}'
    alert(msg, alert.freq_once_per_bar_close)

if buy_sqqq
    msg = '{"action":"BUY_SQQQ","symbol":"SQQQ","position_size":' + str.tostring(position_size) + ',"stop_loss_pct":' + str.tostring(stop_loss_pct) + ',"zscore":' + str.tostring(zscore, "#.##") + ',"price":' + str.tostring(sqqq_price, "#.##") + ',"ratio":' + str.tostring(price_ratio, "#.####") + ',"trend":"' + trend_str + '"}'
    alert(msg, alert.freq_once_per_bar_close)

if exit_signal
    exit_reason = exit_tqqq_ok ? "TQQQ_NORMAL" : exit_tqqq_stop ? "TQQQ_STOP" : exit_sqqq_ok ? "SQQQ_NORMAL" : "SQQQ_STOP"
    msg = '{"action":"EXIT","reason":"' + exit_reason + '","zscore":' + str.tostring(zscore, "#.##") + ',"price":' + str.tostring(close, "#.##") + ',"ratio":' + str.tostring(price_ratio, "#.####") + ',"trend":"' + trend_str + '"}'
    alert(msg, alert.freq_once_per_bar_close)
