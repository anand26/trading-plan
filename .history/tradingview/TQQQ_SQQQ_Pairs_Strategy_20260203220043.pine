// ============================================================================
// TQQQ/SQQQ Pairs Ratio Strategy - Z-Score Mean Reversion
// Version: 3.2 (Optimal Parameters from Backtest)
// 
// This script calculates the TQQQ/SQQQ price ratio Z-score and generates
// trading signals when the ratio deviates significantly from its mean.
//
// Logic:
//   - Z-score < -entry_zscore → TQQQ is relatively cheap → BUY TQQQ
//   - Z-score > +entry_zscore → SQQQ is relatively cheap → BUY SQQQ
//   - Position exits when Z-score normalizes toward 0
// ============================================================================

//@version=5
indicator("TQQQ/SQQQ Pairs Z-Score", overlay=false)

// ============================================================================
// STRATEGY PARAMETERS (All configurable in TradingView Settings)
// ============================================================================

// Z-Score Parameters
zscore_lookback = input.int(46, "Z-Score Lookback Bars", minval=10, maxval=200, tooltip="Number of bars for Z-score calculation. Optimal: 46")
entry_zscore = input.float(1.5, "Entry Z-Score Threshold", minval=0.5, maxval=3.0, step=0.1, tooltip="Enter position when |Z| exceeds this. Optimal: 1.5")
exit_zscore = input.float(0.32, "Exit Z-Score Threshold", minval=0.1, maxval=1.0, step=0.01,
    tooltip="Exit position when |Z| falls below this. Optimal: 0.32")
stop_zscore = input.float(3.0, "Stop Z-Score Threshold", minval=2.0, maxval=5.0, step=0.25,
    tooltip="Stop loss if |Z| exceeds this (spread diverging). Optimal: 3.0")

// Execution Parameters (sent to webhook)
position_size = input.float(0.57, "Position Size (%)", minval=0.1, maxval=1.0, step=0.01, tooltip="Percentage of portfolio per trade. Optimal: 0.57 (57%)")
stop_loss_pct = input.float(0.02, "Stop Loss (%)", minval=0.005, maxval=0.10, step=0.005,
    tooltip="Hard stop loss percentage. Optimal: 0.02 (2%)")

// Webhook Configuration
webhook_url = input.string("", "Webhook URL", tooltip="Your webhook server URL (e.g., https://xxx.ngrok.io/webhook)")

// ============================================================================
// FETCH TQQQ AND SQQQ PRICES
// ============================================================================

// Get TQQQ and SQQQ close prices (use same timeframe as chart)
tqqq_price = request.security("TQQQ", timeframe.period, close)
sqqq_price = request.security("SQQQ", timeframe.period, close)

// ============================================================================
// CALCULATE PRICE RATIO AND Z-SCORE
// ============================================================================

// Price ratio: TQQQ / SQQQ
price_ratio = tqqq_price / sqqq_price

// Z-Score calculation
ratio_mean = ta.sma(price_ratio, zscore_lookback)
ratio_std = ta.stdev(price_ratio, zscore_lookback)
zscore = (price_ratio - ratio_mean) / ratio_std

// ============================================================================
// SIGNAL GENERATION
// ============================================================================

// Track position state (for visualization only - webhook server is source of truth)
var string position_state = "FLAT"
var float entry_price = na
var float entry_zscore_val = na

// Entry signals
buy_tqqq_signal = zscore < -entry_zscore and position_state == "FLAT"
buy_sqqq_signal = zscore > entry_zscore and position_state == "FLAT"

// Exit signals (based on current position)
exit_tqqq_normal = position_state == "LONG_TQQQ" and zscore > -exit_zscore
exit_tqqq_stop = position_state == "LONG_TQQQ" and zscore < -stop_zscore
exit_sqqq_normal = position_state == "LONG_SQQQ" and zscore < exit_zscore
exit_sqqq_stop = position_state == "LONG_SQQQ" and zscore > stop_zscore

// Combined exit signal
exit_signal = exit_tqqq_normal or exit_tqqq_stop or exit_sqqq_normal or exit_sqqq_stop

// Update position state (for visualization)
if buy_tqqq_signal
    position_state := "LONG_TQQQ"
    entry_price := tqqq_price
    entry_zscore_val := zscore
else if buy_sqqq_signal
    position_state := "LONG_SQQQ"
    entry_price := sqqq_price
    entry_zscore_val := zscore
else if exit_signal
    position_state := "FLAT"
    entry_price := na
    entry_zscore_val := na

// ============================================================================
// PLOTTING
// ============================================================================

// Z-Score plot
plot(zscore, "Z-Score", color=color.blue, linewidth=2)

// Threshold lines
hline(entry_zscore, "Entry Long SQQQ", color=color.red, linestyle=hline.style_dashed)
hline(-entry_zscore, "Entry Long TQQQ", color=color.green, linestyle=hline.style_dashed)
hline(exit_zscore, "Exit SQQQ", color=color.orange, linestyle=hline.style_dotted)
hline(-exit_zscore, "Exit TQQQ", color=color.orange, linestyle=hline.style_dotted)
hline(stop_zscore, "Stop SQQQ", color=color.red, linestyle=hline.style_solid)
hline(-stop_zscore, "Stop TQQQ", color=color.red, linestyle=hline.style_solid)
hline(0, "Zero", color=color.gray, linestyle=hline.style_solid)

// Background color based on position
bgcolor(position_state == "LONG_TQQQ" ? color.new(color.green, 90) : 
        position_state == "LONG_SQQQ" ? color.new(color.red, 90) : na)

// Signal markers
plotshape(buy_tqqq_signal, "Buy TQQQ", shape.triangleup, location.bottom, color.green, size=size.normal)
plotshape(buy_sqqq_signal, "Buy SQQQ", shape.triangledown, location.top, color.red, size=size.normal)
plotshape(exit_signal, "Exit", shape.xcross, location.absolute, color.orange, size=size.small)

// ============================================================================
// ALERTS WITH JSON PAYLOAD
// ============================================================================

// Build JSON payloads for webhook
// Note: In TradingView, you'll set the alert message to these JSON strings

// BUY TQQQ Alert
if buy_tqqq_signal
    alert_message_tqqq = '{"action": "BUY_TQQQ", "symbol": "TQQQ", "position_size": ' + str.tostring(position_size) + ', "stop_loss_pct": ' + str.tostring(stop_loss_pct) + ', "zscore": ' + str.tostring(zscore, "#.##") + ', "price": ' + str.tostring(tqqq_price, "#.##") + ', "ratio": ' + str.tostring(price_ratio, "#.####") + '}'
    alert(alert_message_tqqq, alert.freq_once_per_bar_close)

// BUY SQQQ Alert  
if buy_sqqq_signal
    alert_message_sqqq = '{"action": "BUY_SQQQ", "symbol": "SQQQ", "position_size": ' + str.tostring(position_size) + ', "stop_loss_pct": ' + str.tostring(stop_loss_pct) + ', "zscore": ' + str.tostring(zscore, "#.##") + ', "price": ' + str.tostring(sqqq_price, "#.##") + ', "ratio": ' + str.tostring(price_ratio, "#.####") + '}'
    alert(alert_message_sqqq, alert.freq_once_per_bar_close)

// EXIT Alert
if exit_signal
    exit_reason = exit_tqqq_normal ? "TQQQ_NORMAL" : exit_tqqq_stop ? "TQQQ_STOP" : exit_sqqq_normal ? "SQQQ_NORMAL" : "SQQQ_STOP"
    alert_message_exit = '{"action": "EXIT", "reason": "' + exit_reason + '", "position_size": ' + str.tostring(position_size) + ', "zscore": ' + str.tostring(zscore, "#.##") + ', "price": ' + str.tostring(close, "#.##") + ', "ratio": ' + str.tostring(price_ratio, "#.####") + '}'
    alert(alert_message_exit, alert.freq_once_per_bar_close)

// ============================================================================
// INFO TABLE
// ============================================================================

var table info_table = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80))

if barstate.islast
    table.cell(info_table, 0, 0, "Parameter", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, "Value", text_color=color.white, text_size=size.small)
    
    table.cell(info_table, 0, 1, "Z-Score", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(zscore, "#.###"), text_color=zscore > 0 ? color.red : color.green, text_size=size.small)
    
    table.cell(info_table, 0, 2, "Position", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 2, position_state, text_color=position_state == "FLAT" ? color.gray : color.yellow, text_size=size.small)
    
    table.cell(info_table, 0, 3, "TQQQ Price", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(tqqq_price, "#.##"), text_color=color.white, text_size=size.small)
    
    table.cell(info_table, 0, 4, "SQQQ Price", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 4, str.tostring(sqqq_price, "#.##"), text_color=color.white, text_size=size.small)
    
    table.cell(info_table, 0, 5, "Ratio", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 5, str.tostring(price_ratio, "#.####"), text_color=color.white, text_size=size.small)
    
    table.cell(info_table, 0, 6, "Position Size", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 6, str.tostring(position_size * 100, "#") + "%", text_color=color.white, text_size=size.small)
    
    table.cell(info_table, 0, 7, "Stop Loss", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 7, str.tostring(stop_loss_pct * 100, "#.#") + "%", text_color=color.white, text_size=size.small)
